# Required for signed sessions (min 32 characters). Generate with:
#   openssl rand -base64 48
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Used by seed to create the first admin user (password stored as bcrypt hash in DB)
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=change-me-to-a-strong-password

# Prisma — local Docker Postgres (see docker-compose.yml)
DATABASE_URL="postgresql://family_tree:family_tree_password@localhost:5433/family_tree_app?schema=public"

# Optional: force data.json fallback when DB empty/unavailable.
# Default: enabled outside production, disabled in production.
# ALLOW_DATA_FALLBACK=1
# ALLOW_DATA_FALLBACK=0

